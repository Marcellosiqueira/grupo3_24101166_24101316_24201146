digraph DER {
  graph [rankdir=LR, splines=polyline, nodesep=0.22, ranksep=1.0, bgcolor="white", fontname="Helvetica"];
  node  [shape=plaintext, fontname="Helvetica"];
  edge  [fontname="Helvetica", fontsize=11, color="#33475b", penwidth=1.3];

  CATEGORIA [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>CATEGORIA</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id_categoria</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">nome</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descricao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valor_diaria</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">franquia_km</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valor_km_excedente</TD></TR>
    </TABLE>>];

  FILIAL [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>FILIAL</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id_filial</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nome</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">cnpj</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">logradouro</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cidade</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">uf</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cep</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefone</TD></TR>
    </TABLE>>];

  CLIENTE [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>CLIENTE</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id_cliente</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nome</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">cpf</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">num_cnh</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cat_cnh</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">validade_cnh</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_nascimento</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">telefone</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">logradouro</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cidade</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">uf</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cep</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_cadastro</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD></TR>
    </TABLE>>];

  VEICULO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>VEICULO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id_veiculo</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">placa</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">chassi</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">marca</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">modelo</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ano_fabricacao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ano_modelo</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">cor</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">combustivel</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">km_atual</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_categoria</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_filial</TD></TR>
    </TABLE>>];

  DOCUMENTO_VEICULO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>DOCUMENTO_VEICULO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT">id_veiculo</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">renavam</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">num_crlv</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ano_licenciamento</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">venc_licenciamento</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">apolice_seguro</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">seguradora</TD></TR>
    </TABLE>>];

  LOCACAO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#C55A11" COLSPAN="2"><FONT COLOR="white"><B>LOCACAO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id_locacao</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_cliente</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_veiculo</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_filial_retirada</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_filial_devolucao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_retirada</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_prevista_devolucao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_real_devolucao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valor_diaria_contratada</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">km_retirada</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">km_devolucao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">valor_total</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD></TR>
    </TABLE>>];

  MANUTENCAO [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>MANUTENCAO</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id_manutencao</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">id_veiculo</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">tipo</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">descricao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_entrada</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">data_saida</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">km_manutencao</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">custo</TD></TR>
      <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">fornecedor</TD></TR>
    </TABLE>>];

  CATEGORIA -> VEICULO [taillabel="1", headlabel="N", label="classifica", labeldistance=2.0, labelangle=0];
  FILIAL    -> VEICULO [taillabel="1", headlabel="N", label="abriga", labeldistance=2.0];
  VEICULO   -> DOCUMENTO_VEICULO [taillabel="1", headlabel="1", label="possui (1:1)", color="#C00000", penwidth=1.8];
  CLIENTE   -> LOCACAO [taillabel="1", headlabel="N", label="realiza"];
  VEICULO   -> LOCACAO [taillabel="1", headlabel="N", label="é alugado em"];
  FILIAL    -> LOCACAO [taillabel="1", headlabel="N", label="retirada", style=dashed];
  FILIAL    -> LOCACAO [taillabel="1", headlabel="N", label="devolução", style=dotted];
  VEICULO   -> MANUTENCAO [taillabel="1", headlabel="N", label="sofre"];

  { rank=same; CATEGORIA; FILIAL; }
  { rank=same; CLIENTE; VEICULO; }
  { rank=same; LOCACAO; DOCUMENTO_VEICULO; }
}
